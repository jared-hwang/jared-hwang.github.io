---
import Base from "../layouts/Base.astro";
import NewsRail from "../components/NewsRail.astro";
import Hero from "../components/Hero.astro";
import ResearchThemes from "../components/ResearchThemes.astro";
import Publications from "../components/Publications.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
---

<Base>
  <div class="page">
    <NewsRail />
    <main data-news-span>
      <Hero />
      <ResearchThemes />
      <Publications />
      <ProjectGrid />
    </main>
  </div>
</Base>

<style>
  /* Columns: left margin | main | right margin. The left margin is a bit
     narrower than the right, nudging main left to balance the news rail. The
     rail sits in the right margin, which never gets narrower than the rail (on
     smaller screens main shifts further left just enough to make room). */
  .page {
    --side-pad: clamp(12px, 2.5vw, 48px);
    display: grid;
    grid-template-columns:
      minmax(0, 0.8fr)
      minmax(0, var(--content-width))
      minmax(calc(var(--news-width) + var(--gutter)), 1fr);
    max-width: 1760px;
    margin: 0 auto;
    padding: 0 var(--side-pad);
  }
  /* Centered in the right margin, keeping a gutter between it and main. Both are
     pinned to row 1, since the rail comes first in the markup. */
  .page > :global(.news) {
    grid-column: 3;
    grid-row: 1;
    width: var(--news-width);
    justify-self: center;
    margin-left: var(--gutter);
  }
  main {
    grid-column: 2;
    grid-row: 1;
    padding-top: 36px;
    /* Only as tall as its content, not stretched to the row. */
    align-self: start;
  }

  @media (max-width: 960px) {
    .page {
      grid-template-columns: minmax(0, 1fr);
      max-width: calc(var(--content-width) + 32px);
      padding: 24px 16px 0;
    }
    .page > :global(.news),
    main {
      grid-column: 1;
      grid-row: auto;
      width: auto;
    }
    .page > :global(.news) {
      justify-self: stretch;
      margin-left: 0;
    }
    main {
      padding-top: 0;
    }
  }
</style>

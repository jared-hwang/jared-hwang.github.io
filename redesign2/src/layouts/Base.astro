---
import "../styles/global.css";
import { SITE } from "../consts";
import { getProfile } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const { cv, banner, banner_link } = (await getProfile()).data;
// Analytics only on the built site, so `npm run dev` and /admin visits aren't counted.
const analyticsId = import.meta.env.PROD ? SITE.googleAnalytics : undefined;
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hind+Vadodara:wght@300;400;500;600;700&display=swap"
    />
    {
      analyticsId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>
          <script is:inline define:vars={{ analyticsId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", analyticsId);
          </script>
        </>
      )
    }
  </head>
  <body>
    {
      banner && (
        <div class="banner">
          {banner_link ? (
            <a href={banner_link} target={/^https?:/.test(banner_link) ? "_blank" : undefined} rel="noopener">
              {banner} →
            </a>
          ) : (
            banner
          )}
        </div>
      )
    }
    <header class="site-header">
      <a class="site-name" href="/">{SITE.title}</a>
      <nav>
        <a href="/#publications">Publications</a>
        <a href="/#projects">Projects</a>
        <a href={cv} target="_blank" rel="noopener">CV</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">© {new Date().getFullYear()} {SITE.title}</footer>
  </body>
</html>

<style>
  /* Notice set in /admin (Home Intro tab). Scrolls away; the header below stays sticky. */
  .banner {
    padding: 5px 16px 6px;
    background: var(--banner-bg);
    color: var(--banner-ink);
    font-size: 0.88rem;
    text-align: center;
  }
  .banner a {
    color: inherit;
    text-decoration: none;
  }
  .banner a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 44px 8px;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--rule);
  }
  .site-name {
    font-size: 1.15rem;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 52px;
    margin-right: 40px;
  }
  nav a {
    font-size: 1.1rem;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: border-color 0.15s;
  }
  nav a:hover {
    border-color: var(--ink);
  }
  .site-footer {
    padding: 40px 16px;
    text-align: center;
    color: var(--ink-faint);
    font-size: 0.85rem;
  }

  @media (max-width: 720px) {
    .site-header {
      padding: 12px 16px 8px;
    }
    nav {
      gap: 20px;
      margin-right: 0;
    }
    nav a {
      font-size: 1rem;
    }
  }
</style>

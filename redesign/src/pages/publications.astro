---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { SITE } from "../consts";
import PublicationItem from "../components/PublicationItem.astro";

const pubs = (await getCollection("publications")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const yearOf = (d: Date) => d.getUTCFullYear();

// Group publications by year (preserving sort order)
const byYear = new Map<number, typeof pubs>();
for (const p of pubs) {
  const y = yearOf(p.data.date);
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
---

<Base title="Publications" description="Publications by Jared Hwang">
  <header class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight">Publications</h1>
    <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
      You can also find my articles on
      <a
        href={SITE.links.scholar}
        class="underline decoration-accent-600/50 underline-offset-4 hover:decoration-accent-700 dark:decoration-accent-400/60 dark:hover:decoration-accent-300"
        >my Google Scholar profile</a
      >.
    </p>
  </header>

  <div
    id="filter-toggle"
    class="mb-8 inline-flex rounded-md border border-accent-700/40 dark:border-accent-400/40"
    role="tablist"
  >
    <button
      type="button"
      data-filter="selected"
      class="filter-button px-4 py-1.5 text-sm font-medium transition aria-pressed:bg-accent-600 aria-pressed:text-white dark:aria-pressed:bg-accent-500"
      aria-pressed="true"
    >
      Selected
    </button>
    <button
      type="button"
      data-filter="all"
      class="filter-button px-4 py-1.5 text-sm font-medium transition aria-pressed:bg-accent-600 aria-pressed:text-white dark:aria-pressed:bg-accent-500"
      aria-pressed="false"
    >
      All
    </button>
  </div>

  <div id="publications-list" class="space-y-10">
    {
      Array.from(byYear.entries()).map(([year, list]) => (
        <section data-year={year} class="md:flex md:items-start md:gap-4">
          <h2 class="pub-year-header mb-4 text-lg font-semibold tracking-tight text-neutral-700 dark:text-neutral-300 md:sticky md:top-6 md:mb-0 md:w-12 md:shrink-0 md:text-right">
            {year}
          </h2>
          <ul class="divide-y divide-neutral-200 dark:divide-neutral-800 md:min-w-0 md:flex-1 md:border-l md:border-neutral-200 md:pl-6 md:dark:border-neutral-800">
            {list.map((pub) => (
              <PublicationItem pub={pub} />
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<script>
  (() => {
    const buttons = document.querySelectorAll<HTMLButtonElement>(
      "#filter-toggle .filter-button",
    );
    const items =
      document.querySelectorAll<HTMLElement>(".publication-item");
    const sections =
      document.querySelectorAll<HTMLElement>("#publications-list section");

    function applyFilter(filter: "selected" | "all") {
      items.forEach((item) => {
        const isSelected = item.dataset.selected === "true";
        item.hidden = filter === "selected" && !isSelected;
      });
      sections.forEach((section) => {
        const anyVisible = section.querySelector<HTMLElement>(
          ".publication-item:not([hidden])",
        );
        section.hidden = !anyVisible;
      });
      buttons.forEach((b) => {
        b.setAttribute(
          "aria-pressed",
          (b.dataset.filter === filter).toString(),
        );
      });
    }

    buttons.forEach((b) => {
      b.addEventListener("click", () => {
        applyFilter(b.dataset.filter as "selected" | "all");
      });
    });

    applyFilter("selected");
  })();
</script>

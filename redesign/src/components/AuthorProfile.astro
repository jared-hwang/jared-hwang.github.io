---
import { SITE } from "../consts";
import SocialLink from "./SocialLink.astro";

const socials = [
  { key: "email", label: "Email", href: `mailto:${SITE.email}`, icon: "envelope" },
  { key: "scholar", label: "Google Scholar", href: SITE.links.scholar, icon: "scholar" },
  { key: "linkedin", label: "LinkedIn", href: SITE.links.linkedin, icon: "linkedin" },
  { key: "twitter", label: "Twitter", href: SITE.links.twitter, icon: "twitter" },
] as const;
---

<aside class="author-profile">
  <img
    src={SITE.avatar}
    alt={SITE.author}
    class="author-avatar mb-4 h-32 w-32 rounded-full object-cover"
  />
  <h2 class="author-name text-lg font-semibold tracking-tight">
    {SITE.author}
  </h2>
  <p
    class="author-bio mt-2 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400"
  >
    {SITE.description}
  </p>

  <p
    class="author-location mt-3 flex items-center gap-1.5 text-xs text-neutral-500 dark:text-neutral-400"
  >
    <svg
      class="h-3.5 w-3.5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
      <circle cx="12" cy="10" r="3"></circle>
    </svg>
    {SITE.location}
  </p>

  <!-- Mobile: collapsible dropdown (hidden on desktop) -->
  <div class="socials-collapsible mt-4 md:hidden" data-expanded="false">
    <button
      type="button"
      class="socials-toggle flex w-full cursor-pointer items-center justify-between rounded-md border border-neutral-200 px-3 py-2.5 text-sm text-neutral-700 transition-colors hover:border-accent-600/50 hover:bg-accent-50 hover:text-accent-700 dark:border-neutral-800 dark:text-neutral-300 dark:hover:border-accent-400/40 dark:hover:bg-accent-950/40 dark:hover:text-accent-300"
      aria-expanded="false"
      aria-controls="socials-panel"
    >
      <span class="font-medium">Socials</span>
      <svg
        class="socials-chevron h-4 w-4 transition-transform"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>
    <div class="socials-panel" id="socials-panel">
      <div>
        <ul class="author-socials mt-2 space-y-1.5 text-sm">
          {socials.map((s) => <SocialLink s={s} />)}
        </ul>
      </div>
    </div>
  </div>

  <!-- Desktop: always-visible list (hidden on mobile) -->
  <ul class="author-socials mt-4 hidden space-y-1.5 text-sm md:block">
    {socials.map((s) => <SocialLink s={s} />)}
  </ul>
</aside>

<style>
  .socials-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .socials-panel > div {
    overflow: hidden;
  }
  .socials-collapsible[data-expanded="true"] .socials-panel {
    grid-template-rows: 1fr;
  }
  .socials-collapsible[data-expanded="true"] .socials-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".socials-collapsible").forEach((el) => {
    const btn = el.querySelector<HTMLButtonElement>(".socials-toggle");
    if (!btn) return;
    btn.addEventListener("click", () => {
      const open = el.dataset.expanded === "true";
      el.dataset.expanded = open ? "false" : "true";
      btn.setAttribute("aria-expanded", open ? "false" : "true");
    });
  });
</script>

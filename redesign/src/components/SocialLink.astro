---
interface Props {
  s: {
    key: string;
    label: string;
    href: string;
    icon: string;
  };
}

const { s } = Astro.props;
---

<li class={`social-link social-link-${s.key}`}>
  <a
    href={s.href}
    class="flex items-center gap-2.5 rounded-md border border-neutral-200 px-3 py-2.5 text-neutral-700 transition-colors hover:border-accent-600/50 hover:bg-accent-50 hover:text-accent-700 dark:border-neutral-800 dark:text-neutral-300 dark:hover:border-accent-400/40 dark:hover:bg-accent-950/40 dark:hover:text-accent-300"
  >
    <span class="inline-flex h-5 w-5 items-center justify-center" aria-hidden="true">
      {s.icon === "envelope" && (
        <svg
          class="h-full w-full"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m22 6-10 7L2 6" />
        </svg>
      )}
      {s.icon === "github" && (
        <svg class="h-full w-full" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.01c-3.2.7-3.87-1.37-3.87-1.37-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.24.73-1.53-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18A11 11 0 0 1 12 6.8a11 11 0 0 1 2.88.39c2.2-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.79.56A10.5 10.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
        </svg>
      )}
      {s.icon === "scholar" && (
        <svg
          class="h-full w-full"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
          <path d="M6 12v5c3 3 9 3 12 0v-5" />
        </svg>
      )}
      {s.icon === "linkedin" && (
        <svg class="h-full w-full" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.37V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zm1.78 13.02H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45C23.2 24 24 23.23 24 22.28V1.72C24 .77 23.2 0 22.22 0z" />
        </svg>
      )}
      {s.icon === "twitter" && (
        <svg class="h-full w-full" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
        </svg>
      )}
    </span>
    <span>{s.label}</span>
  </a>
</li>

<style>
  /* Rainbow sheen on hover — restricted to the button border.
     Uses the CSS "gradient border" trick: the pseudo-element fills the
     button area with a rainbow gradient, then a mask carves out the
     inner content-box so only the ring around the edge remains visible.

     Tunables:
       --sheen-alpha     : per-color opacity (border is thin, so 0.7–1.0 works)
       --sheen-thickness : ring thickness; matches the existing 1px border
       --sheen-speed     : seconds for one full drift cycle
       --sheen-fade      : ms for fade-in / fade-out
  */
  .social-link a {
    --sheen-alpha: 0.85;
    --sheen-thickness: 1px;
    --sheen-speed: 7s;
    --sheen-fade: 400ms;
    position: relative;
    isolation: isolate;
  }
  .social-link a::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    padding: var(--sheen-thickness);
    opacity: 0;
    transition: opacity var(--sheen-fade) ease;
    background: linear-gradient(
      115deg,
      oklch(80% 0.16 25 / var(--sheen-alpha)),
      oklch(82% 0.16 80 / var(--sheen-alpha)),
      oklch(78% 0.16 145 / var(--sheen-alpha)),
      oklch(74% 0.18 215 / var(--sheen-alpha)),
      oklch(70% 0.20 290 / var(--sheen-alpha)),
      oklch(80% 0.16 25 / var(--sheen-alpha))
    ) border-box;
    background-size: 220% 100%;
    background-position: 0% 50%;
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
  }
  .social-link a:hover::after {
    opacity: 1;
    animation: rainbow-drift var(--sheen-speed) linear infinite;
  }
  @keyframes rainbow-drift {
    0%   { background-position: 0% 50%; }
    100% { background-position: 220% 50%; }
  }
</style>
